// 托盘：AppTray 是 StatusNotifier 路径的系统托盘菜单；TrayMenu 是 XEmbed 面板上
// 由程序自己画的菜单窗口，条目、顺序与配色按设计稿《系统托盘 · 图标、菜单与实现提示》。
// 「设置…」一行是用户确认后补的：顶栏严格保持设计稿的三个按钮，设置入口放这里。

import { Theme } from "theme.slint";
import { NamedIcon } from "widgets.slint";

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/icon-128.png");
    in-out property <string> tip: "桌面提醒 · 后台运行中";
    tooltip: tip;
    title: "桌面提醒";
    callback show-window();
    callback toggle-window();
    callback new-reminder();
    callback backup();
    callback open-settings();
    callback quit-app();
    clicked => { root.toggle-window(); }
    Menu {
        MenuItem {
            title: "打开主窗口";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: "新建提醒…";
            activated => { root.new-reminder(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "备份…";
            activated => { root.backup(); }
        }
        MenuItem {
            title: "设置…";
            activated => { root.open-settings(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "退出";
            activated => { root.quit-app(); }
        }
    }
}

// 一行菜单项：高 32、圆角 6、左内边距 10、图标 16、间距 10。
component MenuRow inherits Rectangle {
    in property <string> icon-name;
    in property <string> label;
    in property <color> ink: Theme.menu-ink;
    in property <color> row-bg: transparent;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: area.has-hover && root.row-bg == transparent ? Theme.hover : root.row-bg;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 16px;
            height: 100%;
            horizontal-stretch: 0;
            NamedIcon {
                icon-name: root.icon-name;
                s: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.row-bg == transparent ? 400 : 500;
            color: root.ink;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 分隔线：1px，左右各 4px 内缩，上下各留 2px。
component MenuDivider inherits Rectangle {
    height: 5px;
    Rectangle {
        x: 4px;
        y: 2px;
        width: parent.width - 8px;
        height: 1px;
        background: Theme.menu-line;
    }
}

export component TrayMenu inherits Window {
    no-frame: true;
    always-on-top: true;
    width: 264px;
    height: 292px;
    background: Theme.surface;
    default-font-family: root.ui-font;

    in-out property <string> ui-font: "Noto Sans CJK SC";
    in-out property <string> status-text: "";
    in-out property <string> next-text: "";

    callback show-main();
    callback new-reminder();
    callback backup();
    callback open-settings();
    callback quit-app();
    callback dismiss();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.menu-border;
        background: Theme.surface;

        VerticalLayout {
            padding: 6px;
            spacing: 2px;

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 6px;
                spacing: 0px;
                Text {
                    text: "桌面提醒";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: root.status-text;
                    font-size: 12px;
                    color: Theme.text3;
                    overflow: elide;
                }
            }

            MenuDivider { }

            MenuRow {
                icon-name: "menu-window-pri";
                label: "打开主窗口";
                ink: Theme.menu-pri;
                row-bg: Theme.menu-pri-bg;
                clicked => { root.show-main(); root.dismiss(); }
            }
            MenuRow {
                icon-name: "menu-plus";
                label: "新建提醒…";
                clicked => { root.new-reminder(); root.dismiss(); }
            }

            MenuDivider { }

            MenuRow {
                icon-name: "menu-clock";
                label: root.next-text;
                ink: Theme.text3;
                clicked => { root.show-main(); root.dismiss(); }
            }

            MenuDivider { }

            MenuRow {
                icon-name: "menu-download";
                label: "备份…";
                clicked => { root.backup(); root.dismiss(); }
            }

            MenuDivider { }

            MenuRow {
                icon-name: "menu-gear";
                label: "设置…";
                clicked => { root.open-settings(); root.dismiss(); }
            }

            MenuDivider { }

            MenuRow {
                icon-name: "menu-power";
                label: "退出";
                ink: Theme.danger;
                clicked => { root.quit-app(); root.dismiss(); }
            }
        }
    }
}
