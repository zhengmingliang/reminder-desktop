// 图标组件：一个字形一个组件，深浅主题各指一张 4 倍图。
// 生成脚本见 packaging/icons/gen-icons.py，字形取自设计稿使用的 lucide 图标。

import { Theme } from "theme.slint";

export component IconBase inherits Image {
    in property <length> s: 16px;
    width: s;
    height: s;
}

export component IcBellPri inherits IconBase {
    source: Theme.dark ? @image-url("../assets/icons/bell-pri-dark.png") : @image-url("../assets/icons/bell-pri.png");
}

export component IcBellOnPri inherits IconBase {
    source: Theme.dark ? @image-url("../assets/icons/bell-on-pri-dark.png") : @image-url("../assets/icons/bell-on-pri.png");
}

