import { ScrollView } from "std-widgets.slint";

export struct ReminderRow {
    id: string,
    title: string,
    summary: string,
    when-text: string,
    badge: string,
    badge-kind: string,
    selected: bool,
    sound-on: bool,
}

export struct DirEntry {
    label: string,
    path: string,
    kind: string,
}

export struct PreviewLine {
    text: string,
}

// Theme.dark switches every token between the light and dark palettes.
// Dark values are sampled from the v2 dark design (rendered DOM).
export global Theme {
    in-out property <bool> dark: false;
    out property <color> canvas: dark ? #12161B : #F2F4F6;
    out property <color> sidebar: dark ? #161B21 : #F7F9FA;
    out property <color> card: dark ? #1A2027 : #FFFFFF;
    out property <color> hover: dark ? #222A33 : #EEF2F5;
    out property <color> ink: dark ? #E8EDF2 : #16212B;
    out property <color> secondary: dark ? #D0D7DF : #2B3844;
    out property <color> label: dark ? #B6C0CA : #46535F;
    out property <color> muted: dark ? #8E9BA8 : #667583;
    out property <color> line: dark ? #293139 : #E1E6EB;
    out property <color> field: dark ? #3B4652 : #C9D1D9;
    out property <color> button-line: dark ? #3B4652 : #D5DCE3;
    out property <color> accent: dark ? #3CC4B3 : #0B6B63;
    out property <color> accent-deep: dark ? #56D6C6 : #095A54;
    out property <color> accent-soft: dark ? #12332F : #E8F3F1;
    out property <color> accent-line: dark ? #1F564F : #BCDAD5;
    out property <color> accent-ink: dark ? #5ED6C7 : #0B5A54;
    out property <color> on-accent: dark ? #12161B : #FFFFFF;
    out property <color> danger: dark ? #F97066 : #B42318;
    out property <color> danger-line: dark ? #7A3A35 : #FDA29B;
    out property <color> warn-bg: dark ? #33270E : #FFF7E6;
    out property <color> warn-line: dark ? #6B5018 : #F1D9A0;
    out property <color> warn-ink: dark ? #F6C766 : #7A4A00;
    out property <color> ok-bg: dark ? #0F3324 : #ECFDF3;
    out property <color> ok-ink: dark ? #47CD89 : #067647;
    out property <color> titlebar: #25282D;
    out property <color> titlebar-ink: #C9CED4;
    out property <color> scrim: #0000004D;
}

component TitleBar inherits Rectangle {
    in property <string> caption;
    in property <bool> minimizable: false;
    callback request-minimize();
    callback request-close();
    height: 32px;
    background: Theme.titlebar;
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    Text {
        width: 100%;
        height: 100%;
        text: root.caption;
        color: Theme.titlebar-ink;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.minimizable : Rectangle {
        x: parent.width - 92px;
        width: 46px;
        height: parent.height;
        background: min-area.has-hover ? #FFFFFF1A : transparent;
        Text {
            width: 100%;
            height: 100%;
            text: "−";
            color: Theme.titlebar-ink;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        min-area := TouchArea {
            clicked => { root.request-minimize(); }
        }
    }
    Rectangle {
        x: parent.width - 46px;
        width: 46px;
        height: parent.height;
        background: close-area.has-hover ? #C42B1C : transparent;
        Text {
            width: 100%;
            height: 100%;
            text: "✕";
            color: Theme.titlebar-ink;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        close-area := TouchArea {
            clicked => { root.request-close(); }
        }
    }
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> quiet: false;
    callback clicked();
    height: 32px;
    border-radius: 6px;
    border-width: primary || quiet ? 0px : 1px;
    border-color: danger ? Theme.danger-line : Theme.button-line;
    background: primary
        ? (area.has-hover ? Theme.accent-deep : Theme.accent)
        : quiet ? transparent : (area.has-hover ? Theme.hover : Theme.card);
    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px;
        font-weight: root.primary ? 600 : 500;
        color: root.primary ? Theme.on-accent : root.danger ? Theme.danger : root.quiet ? Theme.label : Theme.ink;
    }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: active ? Theme.accent : Theme.button-line;
    background: active ? Theme.accent-soft : (area.has-hover ? Theme.hover : Theme.card);
    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 13px;
        font-weight: root.active ? 600 : 500;
        color: root.active ? Theme.accent-ink : Theme.label;
    }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> multiline: false;
    in property <bool> invalid: false;
    in property <length> field-height: 32px;
    callback edited(string);
    public function take-focus() {
        input.focus();
    }
    height: root.field-height;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.invalid ? Theme.danger : Theme.field;
    background: Theme.card;
    input := TextInput {
        x: 10px;
        y: 6px;
        width: parent.width - 20px;
        height: parent.height - 12px;
        vertical-alignment: root.multiline ? top : center;
        font-size: 14px;
        color: Theme.ink;
        single-line: !root.multiline;
        wrap: root.multiline ? word-wrap : no-wrap;
        text <=> root.text;
        edited => { root.edited(self.text); }
    }
    if root.text == "" : Text {
        x: 10px;
        y: 6px;
        height: parent.height - 12px;
        text: root.placeholder;
        color: Theme.muted;
        font-size: 14px;
        vertical-alignment: root.multiline ? top : center;
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled();
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.accent : Theme.field;
    Rectangle {
        x: root.checked ? 20px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #FFFFFF;
        animate x { duration: 120ms; }
    }
    area := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component StatCard inherits Rectangle {
    in property <string> number;
    in property <string> caption;
    height: 78px;
    border-radius: 10px;
    background: Theme.card;
    horizontal-stretch: 1;
    Text {
        x: 17px;
        y: 14px;
        text: root.number;
        font-size: 24px;
        font-weight: 600;
        color: Theme.ink;
    }
    Text {
        x: 17px;
        y: 46px;
        text: root.caption;
        font-size: 12px;
        color: Theme.muted;
    }
}

component TrayRow inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> primary: false;
    callback clicked();
    height: 32px;
    border-radius: 6px;
    background: root.primary ? Theme.accent-soft : (area.has-hover ? Theme.hover : transparent);
    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: root.danger ? Theme.danger : (root.primary ? Theme.accent-ink : Theme.ink);
        font-size: 13px;
        font-weight: root.primary ? 600 : 400;
        vertical-alignment: center;
    }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component MenuDivider inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: 1px;
        background: Theme.line;
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/icon-128.png");
    in-out property <string> tip: "桌面提醒 · 后台运行中";
    tooltip: tip;
    title: "桌面提醒";
    callback show-window();
    callback toggle-window();
    callback new-reminder();
    callback backup();
    callback quit-app();
    clicked => { root.toggle-window(); }
    Menu {
        MenuItem {
            title: "打开主窗口";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: "新建提醒…";
            activated => { root.new-reminder(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "备份…";
            activated => { root.backup(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "退出";
            activated => { root.quit-app(); }
        }
    }
}

export component TrayMenu inherits Window {
    no-frame: true;
    always-on-top: true;
    width: 264px;
    height: 256px;
    background: Theme.card;
    in-out property <string> ui-font: "Noto Sans CJK SC";
    in-out property <string> status-text: "";
    in-out property <string> next-text: "";
    default-font-family: ui-font;
    callback show-main();
    callback new-reminder();
    callback backup();
    callback quit-app();
    callback dismiss();
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.button-line;
        border-radius: 8px;
        VerticalLayout {
            padding: 6px;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 2px;
                Text { text: "桌面提醒"; font-size: 13px; font-weight: 600; color: Theme.ink; }
                Text { text: root.status-text; font-size: 12px; color: Theme.muted; overflow: elide; }
            }
            MenuDivider { }
            TrayRow { label: "打开主窗口"; primary: true; clicked => { root.show-main(); root.dismiss(); } }
            TrayRow { label: "新建提醒…"; clicked => { root.new-reminder(); root.dismiss(); } }
            MenuDivider { }
            Rectangle {
                height: 32px;
                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: root.next-text;
                    color: Theme.label;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            MenuDivider { }
            TrayRow { label: "备份…"; clicked => { root.backup(); root.dismiss(); } }
            TrayRow { label: "退出"; danger: true; clicked => { root.dismiss(); root.quit-app(); } }
        }
    }
}

export component PopupWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    width: 440px;
    height: 540px;
    background: Theme.card;
    in-out property <string> ui-font: "Noto Sans CJK SC";
    in-out property <string> window-title: "提醒";
    in-out property <string> kicker: "提醒";
    in-out property <string> heading: "";
    in-out property <string> body: "";
    in-out property <string> when-text: "";
    in-out property <string> kind-label: "";
    in-out property <string> note: "";
    in-out property <bool> is-snooze: false;
    default-font-family: ui-font;
    callback dismiss();
    callback open-main();
    callback snooze(int);
    FocusScope {
        key-pressed(event) => {
            if (event.text == "1") { root.snooze(5); return accept; }
            if (event.text == "2") { root.snooze(15); return accept; }
            if (event.text == "3") { root.snooze(30); return accept; }
            if (event.text == "4") { root.snooze(60); return accept; }
            if (event.text == Key.Return || event.text == Key.Escape) { root.dismiss(); return accept; }
            reject
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                TitleBar {
                    caption: root.window-title;
                    request-close => { root.dismiss(); }
                }
                Rectangle { height: 3px; background: Theme.accent; }
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    spacing: 12px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: Theme.accent-soft;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: "铃";
                                color: Theme.accent;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            Text { text: root.kicker; font-size: 12px; font-weight: 600; color: Theme.accent; }
                            Text { text: root.when-text; font-size: 12px; color: Theme.muted; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 84px;
                            height: 24px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: Theme.sidebar;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.kind-label;
                                font-size: 12px;
                                color: Theme.label;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: root.heading;
                        font-size: 20px;
                        font-weight: 600;
                        color: Theme.ink;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 121px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: Theme.sidebar;
                        Text {
                            x: 14px;
                            y: 12px;
                            width: parent.width - 28px;
                            text: root.body;
                            font-size: 14px;
                            color: Theme.label;
                            wrap: word-wrap;
                        }
                    }
                    if root.note != "" : Text {
                        text: root.note;
                        font-size: 12px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: "稍后提醒";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Btn { height: 40px; width: 92px; label: "5 分钟"; clicked => { root.snooze(5); } }
                        Btn { height: 40px; width: 92px; label: "15 分钟"; clicked => { root.snooze(15); } }
                        Btn { height: 40px; width: 92px; label: "30 分钟"; clicked => { root.snooze(30); } }
                        Btn { height: 40px; width: 92px; label: "1 小时"; clicked => { root.snooze(60); } }
                    }
                }
                VerticalLayout {
                    height: 64px;
                    Rectangle { height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        padding-top: 14px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 8px;
                        Btn { quiet: true; width: 112px; label: "打开主窗口"; clicked => { root.open-main(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Btn { primary: true; width: 112px; label: "知道了"; clicked => { root.dismiss(); } }
                    }
                }
            }
        }
    }
}

component ReminderItem inherits Rectangle {
    in property <ReminderRow> item;
    in property <string> group;
    callback picked(string);
    property <bool> in-group: root.group == "upcoming" ? (root.item.badge-kind != "fired" && root.item.badge-kind != "paused") : (root.group == "fired" ? root.item.badge-kind == "fired" : root.item.badge-kind == "paused");
    visible: in-group;
    height: in-group ? 60px : 0px;
    body := Rectangle {
    y: 0px;
    width: 100%;
    height: 56px;
    border-radius: 8px;
    background: root.item.selected ? Theme.accent-soft : (row-area.has-hover ? Theme.hover : transparent);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.item.title;
                font-size: 14px;
                font-weight: 600;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: root.item.summary;
                font-size: 12px;
                color: Theme.muted;
                overflow: elide;
            }
        }
        Text {
            text: root.item.when-text;
            font-size: 12px;
            color: root.item.badge-kind == "fired" ? Theme.warn-ink : Theme.accent-ink;
            vertical-alignment: center;
        }
    }
        row-area := TouchArea {
            clicked => { root.picked(root.item.id); }
        }
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    title: "桌面提醒";
    min-width: 1080px;
    min-height: 720px;
    preferred-width: 1280px;
    preferred-height: 860px;
    background: Theme.canvas;
    default-font-family: ui-font;

    in-out property <string> ui-font: "Noto Sans CJK SC";
    in-out property <string> mono-font: "DejaVu Sans Mono";
    in-out property <bool> list-empty: true;
    in-out property <string> main-view: "overview";
    in-out property <string> date-text: "";
    in-out property <string> clock-text: "";
    in-out property <string> zone-text: "";
    in-out property <string> status-text: "";
    in-out property <string> count-text: "";
    in-out property <string> footer-text: "";
    in-out property <string> empty-text: "";
    in-out property <string> history-hint: "";
    in-out property <string> tab-all: "0";
    in-out property <string> tab-pending: "0";
    in-out property <string> tab-today: "0";
    in-out property <string> tab-fired: "0";
    in-out property <string> tab-paused: "0";
    in-out property <string> list-filter: "all";
    in-out property <string> search-text: "";
    in-out property <[ReminderRow]> rows: [];
    in-out property <string> editor-heading: "新建提醒";
    in-out property <string> banner: "";
    in-out property <string> form-title: "";
    in-out property <string> form-body: "";
    in-out property <bool> form-enabled: true;
    in-out property <string> kind: "delay";
    in-out property <string> form-minutes: "";
    in-out property <string> form-date: "";
    in-out property <string> form-time: "";
    in-out property <string> form-cron: "";
    in-out property <string> title-count: "0/40";
    in-out property <string> body-count: "0/200";
    in-out property <string> title-error: "";
    in-out property <string> body-error: "";
    in-out property <string> delay-error: "";
    in-out property <string> delay-hint: "";
    in-out property <string> date-error: "";
    in-out property <string> time-error: "";
    in-out property <string> at-hint: "";
    in-out property <string> cron-error: "";
    in-out property <string> form-error: "";
    in-out property <[PreviewLine]> preview-lines: [];
    in-out property <bool> form-sound: true;
    in-out property <string> sound-label: "";
    in-out property <string> sound-error: "";
    in-out property <bool> delete-enabled: false;
    in-out property <bool> browser-open: false;
    in-out property <string> browser-path: "";
    in-out property <string> browser-picked: "";
    in-out property <[DirEntry]> dir-entries: [];
    in-out property <string> dialog: "";
    in-out property <string> dialog-title: "";
    in-out property <string> dialog-message: "";
    in-out property <string> hover-tip: "";
    in-out property <length> hover-tip-x: 0px;
    in-out property <length> hover-tip-y: 0px;
    in-out property <bool> settings-open: false;
    in-out property <bool> autostart-on: false;
    callback autostart-changed(bool);
    in-out property <[string]> backup-names: [];
    callback restore-backup(int);

    callback search-changed(string);
    callback filter-changed(string);
    callback select-reminder(string);
    callback new-reminder();
    callback minutes-preset(int);
    callback minutes-step(int);
    callback preset(string);
    callback kind-changed(string);
    callback draft-edited();
    callback save();
    callback revert();
    callback delete-request();
    callback backup();
    callback preview-sound();
    callback browse-open();
    callback browse-cancel();
    callback browse-enter(string, string);
    callback browse-use();
    callback use-default-sound();
    callback dialog-confirm();
    callback dialog-cancel();
    callback hide-to-tray();
    callback minimize-window();
    callback quit();

    FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "n") { root.new-reminder(); return accept; }
            if (event.modifiers.control && event.text == "s") { root.save(); return accept; }
            if (event.modifiers.control && event.text == "f") { search-box.take-focus(); return accept; }
            if (event.text == Key.Escape && root.settings-open) { root.settings-open = false; return accept; }
            if (event.text == Key.Escape && root.browser-open) { root.browse-cancel(); return accept; }
            reject
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.canvas;

            VerticalLayout {
                TitleBar {
                    caption: "桌面提醒";
                    minimizable: true;
                    request-minimize => { root.minimize-window(); }
                    request-close => { root.hide-to-tray(); }
                }

                // Header
                Rectangle {
                    height: 53px;
                    background: Theme.card;
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
                    Rectangle {
                        x: 21px;
                        y: 12px;
                        width: 28px;
                        height: 28px;
                        border-radius: 8px;
                        background: Theme.accent;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "铃";
                            color: Theme.on-accent;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        x: 59px;
                        y: 15px;
                        text: "桌面提醒";
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    Rectangle {
                        x: 144px;
                        y: 22px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.ok-ink;
                    }
                    Text {
                        x: 158px;
                        y: 17px;
                        text: root.status-text == "" ? "后台运行中" : root.status-text;
                        font-size: 12px;
                        color: Theme.muted;
                    }
                    Rectangle {
                        x: parent.width - 442px;
                        y: 10px;
                        width: 246px;
                        height: 32px;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.button-line;
                        background: Theme.card;
                        Text {
                            x: 14px;
                            width: 60px;
                            height: parent.height;
                            text: "下一次";
                            font-size: 12px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        if root.rows.length > 0 : Text {
                            x: 62px;
                            width: 100px;
                            height: parent.height;
                            text: root.rows[0].title;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.ink;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if root.rows.length > 0 : Text {
                            x: 166px;
                            width: 70px;
                            height: parent.height;
                            text: root.rows[0].when-text;
                            font-size: 12px;
                            color: Theme.accent;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        if root.rows.length == 0 : Text {
                            x: 62px;
                            width: 170px;
                            height: parent.height;
                            text: root.empty-text;
                            font-size: 12px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        x: parent.width - 181px;
                        y: 15px;
                        width: 1px;
                        height: 22px;
                        background: Theme.line;
                    }
                    Btn {
                        x: parent.width - 166px;
                        y: 10px;
                        width: 72px;
                        label: "备份";
                        clicked => { root.backup(); }
                    }
                    Btn {
                        x: parent.width - 86px;
                        y: 10px;
                        width: 56px;
                        label: "设置";
                        clicked => { root.settings-open = !root.settings-open; }
                    }
                }

                // Body
                HorizontalLayout {
                    vertical-stretch: 1;

                    // Sidebar
                    Rectangle {
                        width: 400px;
                        background: Theme.sidebar;
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 17px;
                            padding-top: 16px;
                            padding-bottom: 16px;
                            spacing: 12px;

                            Rectangle {
                                height: 166px;
                                border-radius: 10px;
                                background: Theme.card;
                                VerticalLayout {
                                    padding: 13px;
                                    spacing: 10px;
                                    Rectangle {
                                        height: 36px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Theme.button-line;
                                        background: Theme.card;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            spacing: 10px;
                                            Text { text: "+"; font-size: 18px; color: Theme.accent; vertical-alignment: center; }
                                            Text { text: "想提醒自己什么？"; font-size: 13px; color: Theme.muted; vertical-alignment: center; }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.new-reminder(); }
                                        }
                                    }
                                    Text {
                                        text: "点选时间即创建";
                                        font-size: 12px;
                                        color: Theme.muted;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Chip { label: "5 分钟后"; clicked => { root.minutes-preset(5); } }
                                        Chip { label: "30 分钟后"; clicked => { root.minutes-preset(30); } }
                                        Chip { label: "1 小时后"; clicked => { root.minutes-preset(60); } }
                                    }
                                    Btn {
                                        label: "更多设置…";
                                        quiet: true;
                                        clicked => { root.new-reminder(); }
                                    }
                                }
                            }

                            search-box := Field {
                                height: 32px;
                                text <=> root.search-text;
                                placeholder: "搜索提醒标题或内容";
                                edited(t) => { root.search-changed(t); }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                Chip { label: "全部 " + root.tab-all; active: root.list-filter == "all"; clicked => { root.list-filter = "all"; root.filter-changed("all"); } }
                                Chip { label: "待触发 " + root.tab-pending; active: root.list-filter == "pending"; clicked => { root.list-filter = "pending"; root.filter-changed("pending"); } }
                                Chip { label: "已触发 " + root.tab-fired; active: root.list-filter == "fired"; clicked => { root.list-filter = "fired"; root.filter-changed("fired"); } }
                                Chip { label: "已停用 " + root.tab-paused; active: root.list-filter == "paused"; clicked => { root.list-filter = "paused"; root.filter-changed("paused"); } }
                            }

                            HorizontalLayout {
                                Text {
                                    text: "提醒列表";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.muted;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: root.count-text;
                                    font-size: 12px;
                                    color: Theme.muted;
                                }
                            }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 0px;
                                    if root.tab-pending != "0" && (root.list-filter == "all" || root.list-filter == "pending") : Text {
                                        height: 24px;
                                        text: "即将触发 · " + root.tab-pending;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                    }
                                    for row in root.rows : ReminderItem {
                                        group: "upcoming";
                                        item: row;
                                        picked(id) => {
                                            root.select-reminder(id);
                                            root.main-view = "edit";
                                        }
                                    }
                                    if root.tab-fired != "0" && (root.list-filter == "all" || root.list-filter == "fired") : Text {
                                        height: 24px;
                                        text: "今天已触发 · " + root.tab-fired;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                    }
                                    for row in root.rows : ReminderItem {
                                        group: "fired";
                                        item: row;
                                        picked(id) => {
                                            root.select-reminder(id);
                                            root.main-view = "edit";
                                        }
                                    }
                                    if root.tab-paused != "0" && (root.list-filter == "all" || root.list-filter == "paused") : Text {
                                        height: 24px;
                                        text: "已停用 · " + root.tab-paused;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                    }
                                    for row in root.rows : ReminderItem {
                                        group: "paused";
                                        item: row;
                                        picked(id) => {
                                            root.select-reminder(id);
                                            root.main-view = "edit";
                                        }
                                    }
                                    if root.rows.length == 0 : Text {
                                        height: 80px;
                                        text: root.empty-text;
                                        font-size: 13px;
                                        color: Theme.muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            Text {
                                text: root.footer-text;
                                font-size: 12px;
                                color: Theme.muted;
                                overflow: elide;
                            }
                        }
                    }

                    // Main area
                    VerticalLayout {
                        horizontal-stretch: 1;

                        if root.main-view == "overview" : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding-left: 32px;
                                padding-right: 32px;
                                padding-top: 28px;
                                padding-bottom: 28px;
                                spacing: 22px;
                                alignment: start;

                                HorizontalLayout {
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: root.date-text; font-size: 12px; color: Theme.muted; }
                                        Text {
                                            text: "今天还有 " + root.tab-today + " 条提醒";
                                            font-size: 22px;
                                            font-weight: 600;
                                            color: Theme.ink;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    VerticalLayout {
                                        alignment: end;
                                        spacing: 4px;
                                        Text { text: "现在"; font-size: 12px; color: Theme.muted; horizontal-alignment: right; }
                                        Text { text: root.clock-text + "  " + root.zone-text; font-size: 12px; color: Theme.label; horizontal-alignment: right; }
                                    }
                                }

                                Rectangle {
                                    height: 172px;
                                    border-radius: 12px;
                                    border-width: 1px;
                                    border-color: Theme.accent-line;
                                    background: Theme.accent-soft;
                                    if root.rows.length > 0 : Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        Text {
                                            x: 25px;
                                            y: 24px;
                                            text: "下一次提醒";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.accent;
                                        }
                                        Rectangle {
                                            x: 110px;
                                            y: 21px;
                                            width: 72px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: Theme.card;
                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: root.rows[0].badge;
                                                font-size: 12px;
                                                color: Theme.label;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            x: 25px;
                                            y: 50px;
                                            text: root.rows[0].when-text;
                                            font-size: 40px;
                                            font-weight: 600;
                                            color: Theme.ink;
                                        }
                                        Text {
                                            x: 25px;
                                            y: 104px;
                                            width: 640px;
                                            text: root.rows[0].title;
                                            font-size: 16px;
                                            font-weight: 600;
                                            color: Theme.ink;
                                            overflow: elide;
                                        }
                                        Text {
                                            x: 25px;
                                            y: 132px;
                                            width: 640px;
                                            text: root.rows[0].summary;
                                            font-size: 12px;
                                            color: Theme.muted;
                                            overflow: elide;
                                        }
                                        Btn {
                                            x: 706px;
                                            y: 50px;
                                            width: 86px;
                                            label: "编辑";
                                            clicked => {
                                                root.select-reminder(root.rows[0].id);
                                                root.main-view = "edit";
                                            }
                                        }
                                    }
                                    if root.rows.length == 0 : Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.empty-text;
                                        font-size: 14px;
                                        color: Theme.muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    StatCard { number: root.tab-pending; caption: "待触发"; }
                                    StatCard { number: root.tab-fired; caption: "已触发"; }
                                    StatCard { number: root.tab-paused; caption: "已停用"; }
                                }

                                Rectangle {
                                    border-radius: 10px;
                                    background: Theme.card;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 10px;
                                        Text { text: "最近记录"; font-size: 14px; font-weight: 600; color: Theme.ink; }
                                        Text { text: root.history-hint; font-size: 13px; color: Theme.label; wrap: word-wrap; }
                                    }
                                }
                            }
                        }

                        if root.main-view == "edit" : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding-left: 32px;
                                padding-right: 32px;
                                padding-top: 20px;
                                padding-bottom: 24px;
                                spacing: 14px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Chip { width: 64px; label: "概览"; active: false; clicked => { root.main-view = "overview"; } }
                                    Chip { width: 64px; label: "编辑"; active: true; }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: root.editor-heading;
                                        font-size: 20px;
                                        font-weight: 600;
                                        color: Theme.ink;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: "已启用";
                                        font-size: 13px;
                                        color: Theme.label;
                                        vertical-alignment: center;
                                    }
                                    Toggle {
                                        checked <=> root.form-enabled;
                                        toggled => { root.draft-edited(); }
                                    }
                                }

                                if root.banner != "" : Rectangle {
                                    height: 36px;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.warn-line;
                                    background: Theme.warn-bg;
                                    Text {
                                        x: 12px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: root.banner;
                                        font-size: 12px;
                                        color: Theme.warn-ink;
                                        vertical-alignment: center;
                                    }
                                }

                                // Basic info card
                                Rectangle {
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.card;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Text { text: "标题"; font-size: 13px; font-weight: 500; color: Theme.label; }
                                            Text { text: "*"; font-size: 13px; color: Theme.danger; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: root.title-count; font-size: 12px; color: Theme.muted; }
                                        }
                                        Field {
                                            text <=> root.form-title;
                                            placeholder: "给这条提醒起个名字";
                                            invalid: root.title-error != "";
                                            edited(t) => { root.draft-edited(); }
                                        }
                                        if root.title-error != "" : Text { text: root.title-error; font-size: 12px; color: Theme.danger; }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Text { text: "正文"; font-size: 13px; font-weight: 500; color: Theme.label; }
                                            Text { text: "（可选）"; font-size: 13px; color: Theme.muted; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: root.body-count; font-size: 12px; color: Theme.muted; }
                                        }
                                        Field {
                                            text <=> root.form-body;
                                            placeholder: "写下要提醒的内容";
                                            multiline: true;
                                            field-height: 64px;
                                            invalid: root.body-error != "";
                                            edited(t) => { root.draft-edited(); }
                                        }
                                        if root.body-error != "" : Text { text: root.body-error; font-size: 12px; color: Theme.danger; }
                                    }
                                }

                                // Schedule card
                                Rectangle {
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.card;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 12px;
                                        Text { text: "何时提醒"; font-size: 14px; font-weight: 600; color: Theme.ink; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Chip { width: 92px; height: 32px; label: "多久之后"; active: root.kind == "delay"; clicked => { root.kind-changed("delay"); } }
                                            Chip { width: 92px; height: 32px; label: "指定时间"; active: root.kind == "at"; clicked => { root.kind-changed("at"); } }
                                            Chip { width: 92px; height: 32px; label: "重复"; active: root.kind == "cron"; clicked => { root.kind-changed("cron"); } }
                                        }

                                        if root.kind == "delay" : VerticalLayout {
                                            spacing: 8px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                Btn { width: 32px; label: "−"; clicked => { root.minutes-step(-5); } }
                                                Field { width: 120px; text <=> root.form-minutes; placeholder: "分钟"; edited(t) => { root.draft-edited(); } }
                                                Btn { width: 32px; label: "+"; clicked => { root.minutes-step(5); } }
                                                Text { text: "分钟后提醒"; font-size: 13px; color: Theme.label; vertical-alignment: center; }
                                            }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                Chip { width: 64px; label: "5 分钟"; clicked => { root.minutes-preset(5); } }
                                                Chip { width: 64px; label: "15 分钟"; clicked => { root.minutes-preset(15); } }
                                                Chip { width: 64px; label: "30 分钟"; clicked => { root.minutes-preset(30); } }
                                                Chip { width: 64px; label: "1 小时"; clicked => { root.minutes-preset(60); } }
                                            }
                                            if root.delay-error != "" : Text { text: root.delay-error; font-size: 12px; color: Theme.danger; }
                                            if root.delay-hint != "" : Text { text: root.delay-hint; font-size: 12px; color: Theme.muted; }
                                        }

                                        if root.kind == "at" : VerticalLayout {
                                            spacing: 8px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Field { horizontal-stretch: 1; text <=> root.form-date; placeholder: "2026-10-18"; edited(t) => { root.draft-edited(); } }
                                                Field { horizontal-stretch: 1; text <=> root.form-time; placeholder: "20:00"; edited(t) => { root.draft-edited(); } }
                                            }
                                            if root.date-error != "" : Text { text: root.date-error; font-size: 12px; color: Theme.danger; }
                                            if root.time-error != "" : Text { text: root.time-error; font-size: 12px; color: Theme.danger; }
                                            if root.at-hint != "" : Text { text: root.at-hint; font-size: 12px; color: Theme.muted; }
                                        }

                                        if root.kind == "cron" : VerticalLayout {
                                            spacing: 8px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                Chip { width: 64px; label: "每小时"; clicked => { root.preset("0 * * * *"); } }
                                                Chip { width: 64px; label: "每天"; clicked => { root.preset("0 9 * * *"); } }
                                                Chip { width: 64px; label: "工作日"; clicked => { root.preset("0 9 * * 1-5"); } }
                                                Chip { width: 64px; label: "每周一"; clicked => { root.preset("0 9 * * 1"); } }
                                                Chip { width: 64px; label: "每月"; clicked => { root.preset("0 9 1 * *"); } }
                                            }
                                            Field { text <=> root.form-cron; placeholder: "分 时 日 月 周"; edited(t) => { root.draft-edited(); } }
                                            if root.cron-error != "" : Text { text: root.cron-error; font-size: 12px; color: Theme.danger; }
                                            Rectangle {
                                                height: 64px;
                                                border-radius: 8px;
                                                background: Theme.accent-soft;
                                                VerticalLayout {
                                                    padding: 12px;
                                                    spacing: 4px;
                                                    Text {
                                                        text: root.preview-lines.length > 0 ? root.preview-lines[0].text : "";
                                                        font-size: 12px;
                                                        color: Theme.label;
                                                        wrap: word-wrap;
                                                    }
                                                    Text {
                                                        text: root.preview-lines.length > 1 ? root.preview-lines[1].text : "";
                                                        font-size: 12px;
                                                        color: Theme.label;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Sound card
                                Rectangle {
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.card;
                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: "播放铃声"; font-size: 14px; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Toggle {
                                                checked <=> root.form-sound;
                                                toggled => { root.draft-edited(); }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                horizontal-stretch: 1;
                                                text: root.sound-label;
                                                font-size: 13px;
                                                color: Theme.label;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Btn { width: 64px; label: "试听"; clicked => { root.preview-sound(); } }
                                            Btn { width: 96px; label: "选择文件…"; clicked => { root.browse-open(); } }
                                            Btn { width: 64px; label: "默认"; clicked => { root.use-default-sound(); } }
                                        }
                                        if root.sound-error != "" : Text { text: root.sound-error; font-size: 12px; color: Theme.danger; }
                                    }
                                }

                                if root.form-error != "" : Text { text: root.form-error; font-size: 12px; color: Theme.danger; wrap: word-wrap; }
                            }
                        }

                        // Footer bar (edit view)
                        if root.main-view == "edit" : Rectangle {
                            height: 60px;
                            background: Theme.card;
                            Rectangle { width: 100%; height: 1px; background: Theme.line; }
                            HorizontalLayout {
                                y: 14px;
                                height: 32px;
                                padding-left: 32px;
                                padding-right: 32px;
                                spacing: 8px;
                                if root.delete-enabled : Btn { width: 72px; label: "删除"; danger: true; clicked => { root.delete-request(); } }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: root.status-text;
                                    font-size: 12px;
                                    color: Theme.ok-ink;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Ctrl+S";
                                    font-size: 12px;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                                Btn { width: 64px; label: "还原"; clicked => { root.revert(); } }
                                Btn { width: 72px; label: "保存"; primary: true; clicked => { root.save(); } }
                            }
                        }
                    }
                }
            }

            // Browser overlay
            if root.browser-open : Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.scrim;
                TouchArea { }
                Rectangle {
                    x: (parent.width - 560px) / 2;
                    y: (parent.height - 460px) / 2;
                    width: 560px;
                    height: 460px;
                    border-radius: 12px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.line;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 10px;
                        Text { text: "选择提示音"; font-size: 15px; font-weight: 600; color: Theme.ink; }
                        Text { text: root.browser-path; font-size: 12px; color: Theme.muted; overflow: elide; }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                for entry in root.dir-entries : Rectangle {
                                    height: 32px;
                                    border-radius: 6px;
                                    background: entry-area.has-hover ? Theme.hover : transparent;
                                    Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: parent.height;
                                        text: entry.label;
                                        font-size: 13px;
                                        color: entry.kind == "dir" ? Theme.accent-ink : Theme.ink;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    entry-area := TouchArea {
                                        clicked => { root.browse-enter(entry.path, entry.kind); }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.browser-picked != "" ? root.browser-picked : "未选择文件";
                                font-size: 12px;
                                color: Theme.label;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Btn { width: 72px; label: "取消"; clicked => { root.browse-cancel(); } }
                            Btn { width: 104px; label: "使用此文件"; primary: true; clicked => { root.browse-use(); } }
                        }
                    }
                }
            }

            // Settings popover: click outside or press Esc to close
            if root.settings-open : Rectangle {
                width: 100%;
                height: 100%;
                TouchArea { clicked => { root.settings-open = false; } }
                Rectangle {
                    x: root.width - 246px;
                    y: 92px;
                    width: 230px;
                    height: 392px;
                    border-radius: 10px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.line;
                    Text { x: 16px; y: 14px; text: "外观"; font-size: 12px; font-weight: 600; color: Theme.muted; }
                    Text { x: 16px; y: 36px; text: "主题"; font-size: 14px; font-weight: 600; color: Theme.ink; }
                    Btn { x: 16px; y: 62px; width: 96px; label: "浅色"; primary: !Theme.dark; clicked => { Theme.dark = false; } }
                    Btn { x: 118px; y: 62px; width: 96px; label: "深色"; primary: Theme.dark; clicked => { Theme.dark = true; } }
                    Text { x: 16px; y: 102px; text: "切换后立即生效"; font-size: 12px; color: Theme.muted; }
                    Rectangle { x: 16px; y: 128px; width: 198px; height: 1px; background: Theme.line; }
                    Text { x: 16px; y: 142px; text: "开机自启动"; font-size: 14px; font-weight: 600; color: Theme.ink; }
                    Rectangle {
                        x: 174px;
                        y: 140px;
                        width: 40px;
                        height: 22px;
                        border-radius: 11px;
                        background: root.autostart-on ? Theme.accent : Theme.field;
                        Rectangle {
                            x: root.autostart-on ? 20px : 2px;
                            y: 2px;
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: #FFFFFF;
                            animate x { duration: 120ms; }
                        }
                        TouchArea { clicked => { root.autostart-changed(!root.autostart-on); } }
                    }
                    Text { x: 16px; y: 166px; text: "登录系统后自动运行"; font-size: 12px; color: Theme.muted; }
                    Rectangle { x: 16px; y: 196px; width: 198px; height: 1px; background: Theme.line; }
                    Text { x: 16px; y: 206px; text: "从备份恢复"; font-size: 14px; font-weight: 600; color: Theme.ink; }
                    Text { x: 16px; y: 232px; visible: root.backup-names.length == 0; text: "暂无备份，点击顶部“备份”生成"; font-size: 12px; color: Theme.muted; wrap: word-wrap; width: 198px; }
                    VerticalLayout {
                        x: 16px;
                        y: 232px;
                        width: 198px;
                        spacing: 4px;
                        for name[index] in root.backup-names : Rectangle {
                            height: 26px;
                            border-radius: 6px;
                            background: restore-touch.has-hover ? Theme.field : transparent;
                            Text { x: 8px; width: parent.width - 16px; height: parent.height; text: name; font-size: 12px; color: Theme.label; vertical-alignment: center; overflow: elide; }
                            restore-touch := TouchArea { clicked => { root.settings-open = false; root.restore-backup(index); } }
                        }
                    }
                }
            }

            // Confirm dialog overlay
            if root.dialog != "" : Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.scrim;
                TouchArea { }
                Rectangle {
                    x: (parent.width - 400px) / 2;
                    y: (parent.height - 180px) / 2;
                    width: 400px;
                    height: 180px;
                    border-radius: 12px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.line;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 10px;
                        Text { text: root.dialog-title; font-size: 15px; font-weight: 600; color: Theme.ink; }
                        Text { text: root.dialog-message; font-size: 13px; color: Theme.label; wrap: word-wrap; vertical-stretch: 1; }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            Btn { width: 80px; label: "取消"; clicked => { root.dialog-cancel(); } }
                            Btn {
                                width: 80px;
                                label: root.dialog == "delete" ? "删除" : (root.dialog == "quit" ? "退出" : (root.dialog == "restore" ? "恢复" : "放弃修改"));
                                danger: root.dialog == "delete";
                                primary: root.dialog != "delete";
                                clicked => {                                                    root.dialog-confirm(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
